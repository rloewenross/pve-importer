<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% if is_granted('ROLE_USER') %}
            <script src="{{ asset('refresh.js') }}" type="module"></script>
        {% endif %}
        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
